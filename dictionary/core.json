  "version": "0.3.0",
  "note": "Layer 0 (semantic primes, after NSM) and Layer 1 (core roots). Every entry: glyph, class, gloss (en/tr), layer, transparency, optional notes. Transparency: transparent = guessable cold; translucent = obvious once told; opaque = arbitrary, allowed only for a capped set of grammar particles.",
  "entries": [
    {
      "glyph": "🔷",
      "class": "particle",
      "en": "[sentence end]",
      "tr": "[cümle sonu]",
      "layer": 0,
      "transparency": "opaque",
      "notes": "The only delimiter. One sentence per line is house style; a line wrap can never break a sentence."
    },
    {
      "glyph": "💬",
      "class": "particle",
      "en": "[says]",
      "tr": "[der]",
      "layer": 0,
      "transparency": "transparent",
      "notes": "Closes a speaker label: 🐟💬 = the fish says. Scopes to the end of the sentence. Also the root WORDS, always first in a compound; as a label closer it is always last, so the two never collide."
    },
    {
      "glyph": "🏷️",
      "class": "particle",
      "en": "[name follows]",
      "tr": "[özel ad]",
      "layer": 0,
      "transparency": "translucent",
      "notes": "A cartouche; the text after it is a proper name in any script, read as one word. Prefix a category glyph so a reader who cannot read the script still knows what kind of thing it is: 👤🏷️Mehmet person, 📍🏷️İstanbul place, 👥🏷️Anthropic group, 📦🏷️Transformer thing, 🐾🏷️Karabaş animal. A name used more than twice is bound once at the top of the document: 👦 ≔ 👤🏷️Mehmet. Never translate a name."
    },
    {
      "glyph": "≔",
      "class": "particle",
      "en": "[define]",
      "tr": "[tanımla]",
      "layer": 0,
      "transparency": "translucent",
      "notes": "Declares a Layer 2 word: 🤖 ≔ 🏷️Transformer. Math script."
    },
